# BRIEVO environment configuration
# These variables are exposed to client-side code (VITE_ prefix).

# Backend API base URL — used by src/services/apiClient.ts
VITE_API_BASE_URL=http://localhost:5000

# Future backend API URL. Left empty in frontend-only mock mode.
# Set e.g. VITE_API_URL=https://api.yourdomain.com when a backend is added.
VITE_API_URL=

# When 'true', the application runs in development demo mode with the
# floating demo account switcher enabled. This does NOT affect future
# production authentication.
VITE_DEMO_MODE=true
